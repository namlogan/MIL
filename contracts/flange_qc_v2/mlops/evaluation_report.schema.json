{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 MLOps Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "model_ref",
    "dataset_snapshot_ref",
    "metrics",
    "slice_metrics",
    "latency_ms_p95",
    "latency_budget_ms_p95",
    "approval_status",
    "promotion_decision",
    "production_authority",
    "source_ref"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "mlops.evaluation_report.v1"
    },
    "model_ref": {
      "type": "string",
      "pattern": "^(registry|mlflow|model)://"
    },
    "dataset_snapshot_ref": {
      "type": "string",
      "pattern": "^dataset://"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "required": ["precision", "recall", "f1"],
      "properties": {
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "slice_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice", "precision", "recall", "support"],
        "properties": {
          "slice": {
            "type": "string",
            "minLength": 1
          },
          "precision": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recall": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "support": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "latency_ms_p95": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "latency_budget_ms_p95": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "approval_status": {
      "type": "string",
      "enum": ["candidate", "shadow_reviewed", "rejected"]
    },
    "promotion_decision": {
      "type": "string",
      "const": "not_approved"
    },
    "production_authority": {
      "type": "boolean",
      "const": false
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
