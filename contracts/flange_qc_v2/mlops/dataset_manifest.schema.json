{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 MLOps Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dataset_snapshot_ref",
    "entity_grain",
    "storage_ref",
    "labels",
    "split_policy",
    "split_counts",
    "privacy_class",
    "contains_pii",
    "contains_customer_data",
    "raw_media_included",
    "approval_status",
    "production_authority",
    "source_ref"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "mlops.dataset_manifest.v1"
    },
    "dataset_snapshot_ref": {
      "type": "string",
      "pattern": "^dataset://"
    },
    "entity_grain": {
      "type": "string",
      "enum": ["frame", "inspection"]
    },
    "storage_ref": {
      "type": "string",
      "pattern": "^(dataset|s3|gs|az|registry)://"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "leakage_guard", "label_timestamp_field", "feature_timestamp_field"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "leakage_guard": {
          "type": "string",
          "const": "point_in_time"
        },
        "label_timestamp_field": {
          "type": "string",
          "minLength": 1
        },
        "feature_timestamp_field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1
        },
        "validation": {
          "type": "integer",
          "minimum": 1
        },
        "test": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "privacy_class": {
      "type": "string",
      "const": "sanitized_metadata_only"
    },
    "contains_pii": {
      "type": "boolean",
      "const": false
    },
    "contains_customer_data": {
      "type": "boolean",
      "const": false
    },
    "raw_media_included": {
      "type": "boolean",
      "const": false
    },
    "approval_status": {
      "type": "string",
      "enum": ["candidate", "shadow_reviewed", "rejected"]
    },
    "production_authority": {
      "type": "boolean",
      "const": false
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
