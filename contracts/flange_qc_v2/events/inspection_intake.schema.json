{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 Inspection Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "inspection_id",
    "product_code",
    "size_group",
    "frame"
  ],
  "oneOf": [
    {
      "required": ["measurements"],
      "not": {"required": ["boundary"]}
    },
    {
      "required": ["boundary"],
      "not": {"required": ["measurements"]}
    }
  ],
  "properties": {
    "contract_version": {
      "const": "inspection.intake.v1"
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1
    },
    "product_code": {
      "type": "string",
      "minLength": 1
    },
    "size_group": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "source_uri", "captured_at", "source_ref"],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "pattern": "^(camera|replay|synthetic)://"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(camera|replay|synthetic)://"
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length_points", "width_points", "diagonals"],
      "properties": {
        "length_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "width_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "diagonals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "unit": {
          "type": "string",
          "enum": ["inch", "mm"]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corners"],
      "properties": {
        "source": {
          "type": "string"
        },
        "corners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_left", "top_right", "bottom_right", "bottom_left"],
          "properties": {
            "top_left": {"$ref": "#/$defs/point"},
            "top_right": {"$ref": "#/$defs/point"},
            "bottom_right": {"$ref": "#/$defs/point"},
            "bottom_left": {"$ref": "#/$defs/point"}
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "model_ref": {"type": "string"},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    }
  }
}
