{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 Inspection Event",
  "type": "object",
  "required": [
    "inspection_id",
    "product_code",
    "product_spec_version",
    "calibration_status",
    "decision",
    "reason_codes",
    "measurements",
    "created_at"
  ],
  "properties": {
    "inspection_id": {
      "type": "string",
      "minLength": 1
    },
    "product_code": {
      "type": "string",
      "minLength": 1
    },
    "product_spec_version": {
      "type": "string",
      "minLength": 1
    },
    "calibration_status": {
      "type": "string",
      "enum": ["approved", "pending", "missing", "failed"]
    },
    "decision": {
      "type": "string",
      "enum": ["PASS", "NG", "BLOCKED", "NOT_EVALUATED", "ASSIST"]
    },
    "phase": {
      "type": "string",
      "enum": ["PHASE_1", "PHASE_2", "PHASE_3", "PHASE_4", "FINAL"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurements": {
      "type": "object",
      "required": ["length_points", "width_points", "diagonals"],
      "properties": {
        "length_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "width_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "diagonals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "unit": {
          "type": "string",
          "enum": ["inch", "mm"]
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "model_ref": {"type": "string"},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "audit_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  }
}
