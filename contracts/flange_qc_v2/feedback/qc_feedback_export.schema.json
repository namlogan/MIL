{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flange QC V2 QC Feedback Export Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "audit_feedback_id",
    "feedback_id",
    "inspection_id",
    "product",
    "inspection_decision",
    "inspection_created_at",
    "feedback_type",
    "reviewer_id",
    "note",
    "shadow_decision",
    "source_ref",
    "feedback_created_at",
    "production_authority",
    "authority_blockers",
    "observations"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "qc_feedback_export.v1"
    },
    "audit_feedback_id": {
      "type": "integer",
      "minimum": 1
    },
    "feedback_id": {
      "type": "string",
      "minLength": 1
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "spec_version"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "spec_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inspection_decision": {
      "type": "string",
      "enum": ["PASS", "NG", "BLOCKED", "NOT_EVALUATED", "ASSIST"]
    },
    "inspection_created_at": {
      "type": "string",
      "minLength": 1
    },
    "feedback_type": {
      "type": "string",
      "enum": ["CONFIRM_BLOCKED", "MARK_FALSE_POSITIVE", "MARK_FALSE_NEGATIVE", "REQUEST_REVIEW"]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "shadow_decision": {
      "type": "string",
      "enum": ["PASS", "NG", "BLOCKED", "NOT_EVALUATED", "ASSIST"]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "feedback_created_at": {
      "type": "string",
      "minLength": 1
    },
    "production_authority": {
      "type": "boolean",
      "const": false
    },
    "authority_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["PRODUCTION_APPROVAL_REQUIRED"]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "model_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
