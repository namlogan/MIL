{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flange QC V2 QC Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_id",
    "inspection_id",
    "feedback_type",
    "reviewer_id",
    "note",
    "shadow_decision",
    "source_ref",
    "created_at",
    "production_authority",
    "authority_blockers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "feedback_id": {
      "type": "string",
      "minLength": 1
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1
    },
    "feedback_type": {
      "type": "string",
      "enum": ["CONFIRM_BLOCKED", "MARK_FALSE_POSITIVE", "MARK_FALSE_NEGATIVE", "REQUEST_REVIEW"]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "shadow_decision": {
      "type": "string",
      "enum": ["PASS", "NG", "BLOCKED", "NOT_EVALUATED", "ASSIST"]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "production_authority": {
      "type": "boolean",
      "const": false
    },
    "authority_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["PRODUCTION_APPROVAL_REQUIRED"]
      }
    }
  }
}
