{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 Shadow Detector Observation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request",
    "observations"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "shadow_detector_observation_request.v1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "source_uri", "captured_at", "source_ref"],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "pattern": "^(synthetic|replay)://"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
