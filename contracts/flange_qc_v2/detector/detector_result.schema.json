{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 Detector Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_id",
    "request",
    "decision",
    "reason_codes",
    "authority_blockers",
    "production_authority",
    "shadow_mode",
    "observations"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "detector.result.v1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "source_uri", "captured_at", "source_ref"],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "pattern": "^(synthetic|replay)://"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["NOT_EVALUATED", "ASSIST", "BLOCKED"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["MODEL_MISSING", "MODEL_REVIEW_REQUIRED"]
      }
    },
    "authority_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["MODEL_APPROVAL_REQUIRED", "PRODUCTION_APPROVAL_REQUIRED"]
      }
    },
    "production_authority": {
      "type": "boolean",
      "const": false
    },
    "shadow_mode": {
      "type": "boolean",
      "const": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "model_ref": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
