{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLANGE QC V2 WebSocket Inspection Snapshot",
  "type": "object",
  "required": [
    "event_type",
    "inspection_id",
    "product",
    "phase",
    "decision",
    "reason_codes",
    "measurements",
    "observations",
    "created_at"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "inspection.snapshot"
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "object",
      "required": ["code", "spec_version"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "spec_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase": {
      "type": "string",
      "enum": ["BOOTSTRAP", "PHASE_1", "PHASE_2", "PHASE_3", "PHASE_4", "FINAL"]
    },
    "decision": {
      "type": "string",
      "enum": ["PASS", "NG", "BLOCKED", "NOT_EVALUATED", "ASSIST"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurements": {
      "type": "object",
      "required": ["length_points", "width_points", "diagonals", "unit"],
      "properties": {
        "length_points": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "width_points": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "diagonals": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "type": "string",
          "enum": ["inch", "mm"]
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "model_ref": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
