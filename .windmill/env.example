# GitHub
GITHUB_REPOSITORY=namlogan/MIL
GITHUB_TOKEN_AGENT_READ=
GITHUB_TOKEN_AGENT_WRITE=
GITHUB_TOKEN_MERGE_BOT=

# AI workers
AUGMENT_MCP_TOKEN=
OPENAI_API_KEY=
AUGMENT_API_TOKEN=
AUGMENT_API_URL=
AUGMENT_SESSION_AUTH=

# Windmill flow defaults
MIL_BASE_BRANCH=main
MIL_GATE_CHECK_NAME=ai-gate/final-review
MIL_MAX_AUTO_FIX_ITERATIONS=2

# Optional local public-webhook relay. Keep the value synced with the
# Windmill secret f/mil/github_webhook_secret when using a tunnel.
MIL_GITHUB_WEBHOOK_SECRET=
MIL_WEBHOOK_RELAY_HOST=127.0.0.1
MIL_WEBHOOK_RELAY_PORT=18090
MIL_WEBHOOK_PUBLIC_ROUTE=/mil/github-webhook
MIL_WINDMILL_WEBHOOK_URL=http://localhost:8090/api/r/admins/mil/github-webhook
MIL_AUTO_DISPATCH_ENABLED=0
MIL_AUTO_DISPATCH_REPO=/Users/mac/Documents/MIL
MIL_AUTO_DISPATCH_QUEUE=.ai-factory/queue/webhooks

# Optional stable Cloudflare named tunnel for the public GitHub webhook.
# The hostname must be in a Cloudflare-managed DNS zone.
MIL_CLOUDFLARE_TUNNEL_NAME=mil-github-webhook
MIL_CLOUDFLARE_HOSTNAME=
MIL_CLOUDFLARED_CONFIG=.windmill/runtime/cloudflared/mil-github-webhook.yml

# Optional no-custom-domain fallback using an ngrok static/dev domain.
# Store the ngrok authtoken in the local ngrok config, not in this file.
MIL_NGROK_DOMAIN=
