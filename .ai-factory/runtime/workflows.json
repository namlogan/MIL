{
  "version": 1,
  "workflows": {
    "default_issue_to_merge": {
      "source_of_truth": "github_issue_and_pull_request",
      "memory_provider": "mem0_memory",
      "memory_retrieve_script": "f/mil/mem0_retrieve",
      "memory_writeback_script": "f/mil/mem0_writeback",
      "memory_checkpoints": [
        "wm_memory_preflight",
        "wm_task_context_pack",
        "wm_agent_handoff_collect",
        "wm_pr_merge_memory_writeback",
        "wm_memory_maintenance"
      ],
      "stages": [
        {
          "name": "issue_to_plan",
          "owner": "codex_developer",
          "context_provider": "augment_context_provider",
          "memory_provider": "mem0_memory",
          "windmill_script": "f/mil/issue_to_plan",
          "required_inputs": [
            "issue_id",
            "task_id",
            "goal",
            "acceptance_criteria",
            "allowed_files",
            "required_checks",
            "restricted_change_check",
            "rollback_note"
          ],
          "outputs": [
            "plan",
            "memory_candidate"
          ]
        },
        {
          "name": "plan_to_pr",
          "owner": "windmill_orchestrator",
          "windmill_script": "f/mil/plan_to_pr",
          "worker_script": "f/mil/codex_worker",
          "worker_contract": "f/mil/codex_worker_contract",
          "must_dispatch_exactly_one_coding_agent": true,
          "default_developer_agent": "codex_developer",
          "only_supported_developer_agent": "codex_developer",
          "context_provider": "augment_context_provider",
          "memory_provider": "mem0_memory",
          "outputs": [
            "branch",
            "pull_request",
            "developer_handoff",
            "agent_handoff_memory_candidate"
          ]
        },
        {
          "name": "control_plane_ci",
          "owner": "github_merge_gate",
          "required_context": "control-plane",
          "blocking": true
        },
        {
          "name": "augment_context_review",
          "owner": "augment_context_provider",
          "purpose": "provide indexed codebase context and risk-relevant references to Codex QA",
          "memory_provider": "mem0_memory",
          "allowed_actions": [
            "retrieve_code_context",
            "summarize_symbols",
            "provide_codebase_context"
          ],
          "forbidden_actions": [
            "create_branch",
            "edit_files",
            "write_commits",
            "open_pr",
            "approve_merge"
          ]
        },
        {
          "name": "codex_qa_gate",
          "owner": "codex_qa",
          "context_provider": "augment_context_provider",
          "memory_provider": "mem0_memory",
          "memory_preflight": "wm_memory_preflight",
          "windmill_script": "f/mil/pr_quality_gate",
          "publishes_status_with": "f/mil/github_commit_status",
          "required_context": "ai-gate/final-review",
          "allowed_decisions": [
            "APPROVE_MERGE",
            "REQUEST_CHANGES",
            "REJECT",
            "BLOCKED_NEEDS_HUMAN"
          ]
        },
        {
          "name": "protected_merge",
          "owner": "github_merge_gate",
          "memory_provider": "mem0_memory",
          "requires_status_contexts": [
            "control-plane",
            "ai-gate/final-review",
            "merge-controller-policy"
          ],
          "requires_pull_request": true,
          "requires_conversation_resolution": true,
          "requires_required_review_count": 0,
          "approval_model": "required_status_check",
          "requires_human_for_restricted_changes": true
        }
      ]
    },
    "ci_or_review_fix": {
      "source_of_truth": "github_pull_request",
      "memory_provider": "mem0_memory",
      "memory_retrieve_script": "f/mil/mem0_retrieve",
      "memory_writeback_script": "f/mil/mem0_writeback",
      "stages": [
        {
          "name": "fix_ci_or_review",
          "owner": "windmill_orchestrator",
          "windmill_script": "f/mil/fix_ci_or_review",
          "max_iterations": 2,
          "context_provider": "augment_context_provider",
          "memory_provider": "mem0_memory",
          "fix_agent": "codex_developer"
        },
        {
          "name": "codex_qa_gate",
          "owner": "codex_qa",
          "memory_provider": "mem0_memory",
          "windmill_script": "f/mil/pr_quality_gate"
        }
      ]
    },
    "delivery_operating_system": {
      "project_intake_gate": ".windmill/flows/project_intake_gate.md",
      "project_bootstrap": ".windmill/flows/project_bootstrap.md",
      "project_readiness_score": ".windmill/flows/project_readiness_score.md",
      "definition_of_ready_check": ".windmill/flows/definition_of_ready_check.md",
      "memory_preflight": ".windmill/flows/memory_preflight.md",
      "task_context_pack": ".windmill/flows/task_context_pack.md",
      "quality_gate_router": ".windmill/flows/quality_gate_router.md",
      "contract_test_gate": ".windmill/flows/contract_test_gate.md",
      "security_gate": ".windmill/flows/security_gate.md",
      "release_candidate_pack": ".windmill/flows/release_candidate_pack.md",
      "staging_deploy": ".windmill/flows/staging_deploy.md",
      "shadow_deploy": ".windmill/flows/shadow_deploy.md",
      "production_approval": ".windmill/flows/production_approval.md",
      "rollback_drill": ".windmill/flows/rollback_drill.md",
      "release_memory_writeback": ".windmill/flows/release_memory_writeback.md",
      "sdlc_metrics_report": ".windmill/flows/sdlc_metrics_report.md"
    },
    "new_project_startup_pipeline": {
      "source_of_truth": "git_docs_tests_issues",
      "memory_policy": "approved_memory_context_only",
      "allow_agent_implementation_before_ready": false,
      "stage_order": [
        "project_intake",
        "memory_preflight",
        "bootstrap_docs",
        "architecture_adr_gate",
        "contract_backlog_gate",
        "repo_ci_bootstrap",
        "agent_delivery_loop",
        "qa_review_merge_gate",
        "release_rollback_gate",
        "operate_learn_memory_maintenance"
      ],
      "flows": {
        "project_intake": ".windmill/flows/project_intake_gate.md",
        "memory_preflight": ".windmill/flows/memory_preflight.md",
        "bootstrap_docs": ".windmill/flows/project_bootstrap.md",
        "architecture_adr_gate": ".windmill/flows/architecture_review.md",
        "contract_bootstrap": ".windmill/flows/contract_bootstrap.md",
        "task_generation": ".windmill/flows/task_generation.md",
        "repo_bootstrap": ".windmill/flows/repo_bootstrap.md",
        "ci_baseline_check": ".windmill/flows/ci_baseline_check.md",
        "agent_assignment": ".windmill/flows/agent_assignment.md",
        "task_context_pack": ".windmill/flows/task_context_pack.md",
        "pr_review_gate": ".windmill/flows/pr_review_gate.md",
        "test_gate": ".windmill/flows/test_gate.md",
        "contract_gate": ".windmill/flows/contract_gate.md",
        "security_gate": ".windmill/flows/security_gate.md",
        "release_gate": ".windmill/flows/release_gate.md",
        "deployment_gate": ".windmill/flows/deployment_gate.md",
        "rollback_pack": ".windmill/flows/rollback_pack.md",
        "postmortem_to_memory": ".windmill/flows/postmortem_to_memory.md",
        "sdlc_metrics_report": ".windmill/flows/sdlc_metrics_report.md",
        "memory_maintenance": ".windmill/flows/memory_maintenance.md"
      }
    },
    "standard_memory_flows": {
      "wm_project_bootstrap": ".windmill/flows/project_bootstrap.md",
      "wm_memory_preflight": ".windmill/flows/memory_preflight.md",
      "wm_task_context_pack": ".windmill/flows/task_context_pack.md",
      "wm_agent_handoff_collect": ".ai-factory/memory/HANDOFF_MEMORY_TEMPLATE.md",
      "wm_pr_merge_memory_writeback": ".windmill/flows/pr_merge_writeback.md",
      "wm_release_memory_writeback": ".windmill/flows/release_memory_writeback.md",
      "wm_incident_digest": ".windmill/flows/incident_digest.md",
      "wm_memory_conflict_review": ".windmill/flows/memory_conflict_review.md",
      "wm_memory_maintenance": ".windmill/flows/memory_maintenance.md",
      "wm_memory_audit_report": ".windmill/flows/memory_audit_report.md"
    }
  }
}
