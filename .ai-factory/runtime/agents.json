{
  "version": 1,
  "agents": {
    "codex_developer": {
      "runtime": "codex",
      "role": "implementation_and_test_worker",
      "default_branch_prefix": "agent/",
      "allowed_actions": [
        "plan",
        "implement_scoped_issue",
        "run_noninteractive_codex_worker",
        "create_isolated_worktree",
        "commit_scoped_changes",
        "open_pr",
        "generate_tests",
        "fix_ci",
        "write_pr_evidence"
      ],
      "forbidden_actions": [
        "merge_main",
        "read_production_secrets",
        "deploy_production",
        "bypass_branch_protection"
      ],
      "requires_issue_scope": true,
      "requires_pull_request": true
    },
    "codex_qa": {
      "runtime": "codex",
      "role": "final_ai_qa_gate_worker",
      "allowed_actions": [
        "inspect_diff",
        "run_required_checks",
        "verify_evidence",
        "emit_aif_gate_result"
      ],
      "forbidden_actions": [
        "author_implementation_commits",
        "merge_main",
        "deploy_production",
        "read_production_secrets"
      ],
      "requires_issue_scope": true,
      "requires_pull_request": true
    },
    "ai_delivery_coordinator": {
      "runtime": "windmill_plus_policy_scripts",
      "role": "routine_delivery_coordinator",
      "allowed_actions": [
        "check_definition_of_ready",
        "label_auto_dispatch_ready_issue",
        "dispatch_exactly_one_codex_worker",
        "watch_pr_checks",
        "request_codex_qa_gate",
        "label_automerge_candidate_pr",
        "route_fix_ci_or_review",
        "request_human_approval_for_exceptions",
        "write_delivery_evidence"
      ],
      "forbidden_actions": [
        "author_app_code",
        "merge_main",
        "bypass_branch_protection",
        "approve_restricted_change",
        "approve_production_release",
        "approve_qc_sop_or_tolerance",
        "deploy_production",
        "read_production_secrets"
      ],
      "requires_definition_of_ready": true,
      "routine_prs_do_not_require_owner_review": true,
      "human_escalation_only_for": [
        "restricted_changes",
        "production_release",
        "qc_sop_or_tolerance_approval",
        "policy_exception",
        "failed_auto_fix_limit",
        "explicit_hold"
      ],
      "writes_code": false
    },
    "augment_context_provider": {
      "runtime": "augment_mcp",
      "role": "codebase_index_and_context_provider",
      "allowed_actions": [
        "expose_codebase_index",
        "retrieve_code_context",
        "summarize_symbols",
        "answer_codebase_context_questions",
        "provide_codebase_context"
      ],
      "forbidden_actions": [
        "implement_scoped_issue",
        "create_branch",
        "open_pr",
        "write_pr_evidence",
        "final_merge_approval",
        "merge_main",
        "deploy_production",
        "read_production_secrets"
      ],
      "requires_codex_session": true,
      "writes_code": false
    },
    "auggie_advisory": {
      "runtime": "auggie_supervised",
      "role": "supervised_advisory_context_reviewer",
      "allowed_actions": [
        "validate_plan",
        "review_diff",
        "diagnose_ci_failure",
        "identify_risks"
      ],
      "forbidden_actions": [
        "final_merge_approval",
        "merge_main",
        "deploy_production",
        "read_production_secrets"
      ],
      "requires_operator": true,
      "writes_code": false,
      "allowed_verdicts": [
        "AUGMENT_REVIEW_PASS",
        "AUGMENT_REVIEW_NOTES",
        "AUGMENT_REVIEW_CHANGES_RECOMMENDED",
        "AUGMENT_REVIEW_BLOCKED"
      ]
    },
    "mem0_memory": {
      "runtime": "mem0_optional",
            "role": "sanitized_long_term_agent_memory_layer",
            "allowed_actions": [
                "wm_memory_preflight",
                "wm_task_context_pack",
                "wm_agent_handoff_collect",
                "wm_pr_merge_memory_writeback",
                "wm_memory_maintenance",
                "wm_memory_conflict_review",
                "wm_memory_audit_report",
                "record_memory_candidates",
                "summarize_repeated_patterns",
                "provide_memory_context"
      ],
      "forbidden_actions": [
        "store_secrets",
        "store_raw_customer_data",
        "store_unredacted_tokens",
        "implement_scoped_issue",
        "create_branch",
        "open_pr",
        "final_merge_approval",
        "merge_main",
        "deploy_production",
        "bypass_branch_protection",
        "read_production_secrets"
      ],
      "requires_sanitization": true,
            "requires_scope": [
                "framework",
                "project",
                "task"
            ],
      "writes_code": false
    },
    "windmill_orchestrator": {
      "runtime": "windmill",
      "role": "cockpit_and_orchestrator",
      "allowed_actions": [
        "receive_webhook",
        "run_agent_worker",
        "publish_ai_gate_status",
        "request_human_approval",
        "comment_on_issue_or_pr"
      ],
      "forbidden_actions": [
        "bypass_branch_protection",
        "reinterpret_gate_policy",
        "author_app_code"
      ],
      "requires_scoped_sync": true
    },
    "github_merge_gate": {
      "runtime": "github",
      "role": "protected_merge_enforcement",
      "allowed_actions": [
        "enforce_required_checks",
        "block_force_pushes",
        "block_deletions",
        "require_conversation_resolution"
      ],
      "forbidden_actions": [
        "ignore_required_checks",
        "merge_without_pull_request",
        "bypass_restricted_human_approval"
      ],
      "required_status_contexts": [
        "control-plane",
        "ai-gate/final-review",
        "merge-controller-policy"
      ]
    }
  }
}
