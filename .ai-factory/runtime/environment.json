{
  "version": 1,
  "required_tools": [
    "git",
    "gh",
    "codex",
    "python3",
    "wmill"
  ],
  "required_github_contexts": [
    "control-plane",
    "ai-gate/final-review"
  ],
  "windmill": {
    "workspace_profile": "mil-local",
    "workspace_id": "admins",
    "scoped_sync_include": "f/mil/**",
    "required_scripts": [
      "f/mil/codex_worker_contract",
      "f/mil/codex_worker",
      "f/mil/plan_to_pr_contract",
      "f/mil/issue_to_plan",
      "f/mil/plan_to_pr",
      "f/mil/pr_quality_gate",
      "f/mil/fix_ci_or_review",
      "f/mil/memory_contract",
      "f/mil/mem0_retrieve",
      "f/mil/mem0_writeback",
      "f/mil/auggie_supervised_advisory",
      "f/mil/github_commit_status",
      "f/mil/github_webhook_router"
    ],
    "required_secret_references": [
      "f/mil/github_status_token",
      "f/mil/github_webhook_secret"
    ]
  },
  "codex_worker": {
    "runner_script": "scripts/agent-flow/codex_worker.py",
    "windmill_script": "f/mil/codex_worker",
    "contract_script": "f/mil/codex_worker_contract",
    "worktree_root": ".ai-factory/tmp/worktrees",
    "evidence_root": ".ai-factory/qa/codex_worker",
    "default_sandbox": "workspace-write",
    "default_approval": "never",
    "execute_agent_default": false,
    "push_default": false,
    "open_pr_default": false,
    "requires_allowed_files": true,
    "requires_restricted_change_empty": true,
    "notes": "Windmill returns a command pack by default. Actual codex exec, push, and PR creation require explicit flags."
  },
  "augment": {
    "context_provider": "augment_mcp",
    "required_local_env": [
      "AUGMENT_MCP_TOKEN"
    ],
    "coding_allowed": false,
    "notes": "Augment exposes codebase index/context to Codex sessions. It is not a MIL coding worker."
  },
  "memory": {
    "provider": "mem0_optional",
    "runtime_agent": "mem0_memory",
    "mode": "local_jsonl_default",
    "local_fallback_store": ".ai-factory/memory/local_memory.jsonl",
    "windmill_retrieve_script": "f/mil/mem0_retrieve",
    "windmill_writeback_script": "f/mil/mem0_writeback",
    "required_metadata_fields": [
      "tenant_id",
      "workspace_id",
      "repo",
      "repo_id",
      "source_uri",
      "confidence",
      "status",
      "visibility",
      "created_by"
    ],
    "required_entity_scope_fields_any_of": [
      "user_id",
      "agent_id",
      "app_id",
      "run_id"
    ],
    "auto_write_memory_types": [
      "agent_performance",
      "ci_pattern",
      "developer_handoff",
      "failure_pattern",
      "incident_learning",
      "merge_gate",
      "operator_note",
      "plan",
      "qa_gate",
      "review_note",
      "run_summary",
      "tool_failure"
    ],
    "approval_required_memory_types": [
      "architecture_decision",
      "human_preference",
      "repo_convention",
      "review_rule",
      "security_policy"
    ],
    "required_local_env": [],
    "optional_local_env": [
      "MEM0_API_KEY",
      "MEM0_BASE_URL",
      "MEM0_ORG_ID",
      "MEM0_PROJECT_ID"
    ],
    "must_sanitize_before_write": true,
    "store_secrets": false,
    "store_raw_customer_data": false,
    "allowed_scopes": [
      "project",
      "task_id",
      "agent",
      "run"
    ],
    "notes": "Mem0 is the optional long-term memory provider. Local JSONL is the deterministic test adapter until a Mem0 Platform or self-hosted endpoint is configured."
  },
  "local_checks": [
    "python3 -m unittest discover -s tests -v",
    "python3 scripts/agent-memory/memory_contract.py --self-test",
    "python3 scripts/agent-gate/validate_ai_factory.py --self-test",
    "python3 scripts/windmill/validate_windmill_project.py --self-test",
    "python3 -m compileall -q scripts tests f",
    "git diff --check"
  ]
}
